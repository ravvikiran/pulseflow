# PulseFlow Environment Variables
# Copy this file to .env if you need to customize

# Database (MySQL) — optional, app works without it
DATABASE_URL=mysql://user:password@localhost:3306/pulseflow

# Server port (default: 3000)
PORT=3000

# Set to "true" to disable Yahoo Finance and use offline simulated data
# USE_SIMULATED_DATA=true

# Optional: API key to protect scheduled job endpoints
# CRON_API_KEY=your-secret-key
