# PulseFlow Environment Variables
# Copy this file to .env if you need to customize.

# Runtime mode. "development" enables Vite HMR; anything else serves dist/.
# (`pnpm dev` and `pnpm start` set this for you.)
# NODE_ENV=production

# Database (MySQL), optional. The app works without it.
DATABASE_URL=mysql://user:password@localhost:3306/pulseflow

# Server port (default: 3000). In production the server fails fast if the
# port is busy; in development it picks the next free port.
PORT=3000


# API key for /api/scheduled/* endpoints (send as the `x-api-key` header).
# Use 16+ random characters, e.g. `openssl rand -hex 24`.
# In production these endpoints are disabled until a key is set.
# CRON_API_KEY=

# Behind a reverse proxy? Set the number of proxy hops (or "true") so rate
# limiting sees real client IPs. Leave unset when exposed directly.
# TRUST_PROXY=1

# Requests per minute per IP allowed on /api (0 disables the limiter).
# API_RATE_LIMIT_PER_MIN=300
